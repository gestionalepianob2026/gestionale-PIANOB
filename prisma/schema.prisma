// Schema dati gestionale PIANO B
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  password  String
  name      String
  role      String      @default("CREW") // CREW | ADMIN
  createdAt DateTime    @default(now())
  bolle     Bolla[]
  movimenti Movimento[]
}

model Product {
  id         String   @id @default(cuid())
  prodotto   String
  categoria  String   // Vini | Bollicine | Bevande | Rum | Whisky | Alimenti ...
  tipologia  String?  // solo vini: Rosso | Bianco | Bollicina | Champagne ...
  zona       String?  // solo vini: regione/area
  fornitore  String?
  prezzoUnit Float    @default(0) // imponibile unitario (netto IVA)
  ivaRate    Float    @default(22) // aliquota IVA %
  quantita   Float    @default(0) // giacenza in magazzino
  sogliaMin  Float    @default(0) // soglia sotto scorta
  bollaId    String?
  bolla      Bolla?   @relation(fields: [bollaId], references: [id])
  movimenti  Movimento[]
  aliases    Alias[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoria])
  @@index([prodotto])
}

// Soprannome/abbreviazione usato dai dipendenti nei messaggi (es. "san pell")
// mappato al prodotto reale. Appreso alla prima conferma, poi riconosciuto da solo.
model Alias {
  id        String   @id @default(cuid())
  termine   String   @unique // soprannome normalizzato (minuscolo, spazi singoli)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  usi       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bolla {
  id        String    @id @default(cuid())
  numero    String?
  fornitore String?
  data      DateTime?
  totale    Float     @default(0)
  imagePath String?
  rawJson   String?   // risposta grezza AI
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  products  Product[]
}

// Movimento di magazzino: carico (rifornimento), scarico (consumo a fine turno)
// o rettifica (conteggio fisico). Lo storico alimenta le statistiche dei consumi.
model Movimento {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tipo      String   // CARICO | SCARICO | RETTIFICA
  quantita  Float    // magnitudine del movimento (sempre positiva)
  qtaPrima  Float    // giacenza prima del movimento
  qtaDopo   Float    // giacenza dopo il movimento
  note      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([tipo])
  @@index([createdAt])
}

// Impostazioni modificabili dal gestionale (chiave → valore), es. la parola
// d'ordine per attivare il bot Telegram.
model Impostazione {
  chiave    String   @id
  valore    String
  updatedAt DateTime @updatedAt
}

// --- Bot Telegram (scarico consumi dal gruppo dei ragazzi) -------------------

// Gruppi (o chat) autorizzati a scaricare il magazzino. Si aggiungono con
// /attiva <codice> scritto nel gruppo; senza questa riga il bot ignora la chat.
model TelegramChat {
  id        String   @id @default(cuid())
  chatId    String   @unique
  titolo    String?
  createdAt DateTime @default(now())
}

// Un messaggio del gruppo già elaborato. La coppia (chatId, messageId) è unica:
// se Telegram rinvia lo stesso aggiornamento, non si scarica due volte.
model TelegramMessaggio {
  id        String         @id @default(cuid())
  chatId    String
  messageId Int
  mittente  String?
  testo     String
  annullato Boolean        @default(false)
  createdAt DateTime       @default(now())
  righe     TelegramRiga[]

  @@unique([chatId, messageId])
  @@index([createdAt])
}

model TelegramRiga {
  id          String            @id @default(cuid())
  messaggioId String
  messaggio   TelegramMessaggio @relation(fields: [messaggioId], references: [id], onDelete: Cascade)
  termine     String
  qta         Float
  // APPLICATA (scaricata) | IN_ATTESA (serve una scelta a pulsanti) | SALTATA | ANNULLATA
  stato       String
  productId   String?
  movimentoId String?
  candidati   String? // JSON: id dei prodotti proposti nei pulsanti
  createdAt   DateTime          @default(now())

  @@index([messaggioId])
}
